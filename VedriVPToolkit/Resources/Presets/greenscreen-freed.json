{
  "schemaVersion": 1,
  "name": "Green screen, FreeD tracking",
  "description": "Green screen stage with built-in FreeD tracking, 1080p25, clean CG out for an external keyer. Choose your video card and camera in the wizard.",
  "mode": "greenScreen",
  "videoIO": {
    "cardFamily": "blackmagic",
    "deviceIndex": 0,
    "inputPort": 1,
    "outputPort": 2,
    "genlockSource": "sdiInput"
  },
  "timing": {
    "frameRate": {
      "numerator": 25,
      "denominator": 1
    },
    "resolution": {
      "width": 1920,
      "height": 1080
    },
    "dropFrameTimecode": false
  },
  "videoOut": {
    "enabled": true,
    "pixelFormat": "yuv10",
    "keyAndFill": false,
    "source": "activeViewport"
  },
  "greenScreen": {
    "createPlateSource": true,
    "createMatteOutput": false,
    "matteOutputPort": 3
  },
  "tracking": {
    "provider": "freed",
    "subjectName": "TrackedCamera",
    "autoApplyOnStartup": true,
    "providerSettings": {}
  },
  "lens": {
    "cameraSensor": "bmd_pyxis_6k",
    "sensorWidthMm": 36,
    "sensorHeightMm": 24
  },
  "selectionOverrides": {}
}
